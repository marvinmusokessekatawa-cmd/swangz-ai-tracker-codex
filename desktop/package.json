{
  "name": "swangz-ai-tracker",
  "productName": "Swangz AI Tracker",
  "version": "1.0.0",
  "description": "Swangz Avenue's AI Adoption Tracker, as a desktop app.",
  "author": "Swangz Avenue <swangz.ai.subscriptions@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.swangzavenue.aitracker",
    "productName": "Swangz AI Tracker",
    "copyright": "\u00a9 Swangz Avenue",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swangz AI Tracker",
      "artifactName": "Swangz-AI-Tracker-${version}-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "Swangz-AI-Tracker-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Swangz AI Tracker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "Swangz-AI-Tracker-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Swangz-AI-Tracker-${version}-${arch}-portable.${ext}"
    }
  }
}
